# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# AAR runtime state
.pytest-aar-home/
*.aar-cache/

# Audit data: fetched on demand by tools/fetch_data.py, never committed.
# 100 MB of Parquet, and data/MANIFEST.json records the SHA-256 of exactly
# which bytes the audit measured.
#
# `data/**` and not `data/`: excluding the directory itself stops git
# descending into it, and a later `!data/audit/audit.json` cannot re-include
# a file whose parent was never entered. The evidence files are small and
# are the point of keeping this directory, so they are re-included
# explicitly.
data/**
!data/MANIFEST.json
!data/audit/
data/audit/**
!data/audit/audit.json
!data/audit/audit.txt
!data/gpu/
data/gpu/**
!data/gpu/cpu_baseline.json
!data/gpu/README.md

# Generated by tools/make_sample_data.py and the example pipeline.
# Both are reproducible from source, so they are outputs, not fixtures.
FY26-orders.xlsx
FY26-report.xlsx

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local scratch
*.log
*.out
*.tmp
.*.txt
.*.err
!requirements*.txt

# Never commit a virtualenv or a built distribution
.venv/
venv/
env/
ENV/
*.egg-info/
build/
dist/
